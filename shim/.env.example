# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Logging
LOG_LEVEL=info
LOG_DIR=/var/log/gematik-shim

# IDP Configuration (can be overridden per request)
DEFAULT_IDP_URL=https://idp.example.com
DEFAULT_CLIENT_ID=your-client-id
DEFAULT_REDIRECT_URI=http://localhost:3000/callback

# Certificate Storage
CERT_STORAGE_DIR=/app/certificates

# Security
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.com
MAX_UPLOAD_SIZE=5mb
