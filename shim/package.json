{
  "name": "gematik-authenticator-shim",
  "version": "1.0.0",
  "description": "Non-interactive authentication shim for Gematik Authenticator",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "docker:build": "docker build -t gematik-shim:latest .",
    "docker:run": "docker run -p 3000:3000 gematik-shim:latest"
  },
  "keywords": [
    "gematik",
    "authentication",
    "smb-c",
    "shim",
    "oauth"
  ],
  "author": "Gematik GmbH",
  "license": "EUPL-1.2",
  "dependencies": {
    "express": "^4.18.2",
    "node-forge": "^1.3.1",
    "node-jose": "^2.2.0",
    "got": "11.8.6",
    "winston": "^3.11.0",
    "uuid": "^9.0.1",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/node-forge": "^1.3.10",
    "@types/multer": "^1.4.11",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
